# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=dummy
JARVIS_CAD_MODEL=gemini-2.5-flash
JARVIS_CAD_FALLBACK_MODELS=gemini-2.5-flash-lite
JARVIS_VISION_MODEL=gemini-2.5-flash
JARVIS_VISION_FALLBACK_MODELS=gemini-2.5-flash-lite
JARVIS_VISION_TIMEOUT_SECONDS=20

# =============================================================================
# WhatsApp provider selection
# Opciones: openwa | openclaw
#   openwa  → WhatsApp usa OpenWA (servicio externo REST, recomendado)
#   openclaw → WhatsApp usa OpenClaw (legacy, fallback)
# =============================================================================
JARVIS_WHATSAPP_PROVIDER=openwa

# =============================================================================
# Tareas (listas con subtareas y progreso)
#   Modelo usado para recomendar el orden de las subtareas (urgencia, tiempo,
#   dependencias). Si no hay cuota/API, hay un fallback heuristico.
# =============================================================================
JARVIS_TASKS_MODEL=gemini-2.5-flash
# =============================================================================
# OpenWA — proveedor principal de WhatsApp
# Ejecutar como servicio externo en C:/Users/<usuario>/OpenWA
#   cd C:/Users/<usuario>/OpenWA && npm run start:dev
#
# Para obtener la API key:
#   Get-Content C:/Users/<usuario>/OpenWA/data/.api-key
#
# Comprobar que está activo:
#   Invoke-RestMethod http://127.0.0.1:2785/api/health
# =============================================================================
JARVIS_OPENWA_ENABLED=true
JARVIS_OPENWA_AUTO_START=true
JARVIS_OPENWA_DIR=ruta_a_openwa
JARVIS_OPENWA_NPM_SCRIPT=dev
JARVIS_OPENWA_BASE_URL=http://127.0.0.1:2785/api
JARVIS_OPENWA_API_KEY=dummy
JARVIS_OPENWA_SESSION_ID=dummy
JARVIS_OPENWA_TIMEOUT_SECONDS=30
JARVIS_OPENWA_SEND_STYLE=send-text
JARVIS_OPENWA_WATCHDOG_ENABLED=true
JARVIS_OPENWA_WATCHDOG_INTERVAL_SECONDS=30
JARVIS_OPENWA_WEBHOOK_URL=http://127.0.0.1:8000/api/openwa/inbound
JARVIS_WHATSAPP_NOTIFY_INBOUND=true
JARVIS_WHATSAPP_VOICE_ANNOUNCE_INBOUND=true

# =============================================================================
# OpenClaw — gateway legacy (Calendar, LinkedIn, email, workflows)
# WhatsApp sólo usa OpenClaw si JARVIS_WHATSAPP_PROVIDER=openclaw.
# Para acciones de productividad (Calendar, LinkedIn, email) siempre se usa
# OpenClaw independientemente del proveedor de WhatsApp.
#
# En Windows puede ser necesario:
#   JARVIS_OPENCLAW_EXECUTABLE=openclaw.cmd
# =============================================================================
JARVIS_OPENCLAW_ENABLED=true
JARVIS_OPENCLAW_AUTO_START=true
JARVIS_OPENCLAW_MODE=cli
JARVIS_OPENCLAW_TIMEOUT_SECONDS=60
JARVIS_OPENCLAW_STATUS_METHOD=health
JARVIS_OPENCLAW_STATUS_FALLBACK_METHOD=status
JARVIS_OPENCLAW_EXECUTABLE=ruta_a_openclaw.cmd
JARVIS_OPENCLAW_ENABLED=true


JARVIS_OPENCLAW_MESSAGE_COMMAND=message,send
JARVIS_OPENCLAW_RESOLVE_COMMAND=channels,resolve
JARVIS_OPENCLAW_REQUIRE_RESOLVE=false
JARVIS_OPENCLAW_GENERIC_CALL_METHOD=

JARVIS_OPENCLAW_BASE_URL=http://127.0.0.1:18789
# Dejar vacío para gateway LOCAL. Solo poner URL (ws://...) para gateway REMOTO,
# y en ese caso es obligatorio definir también JARVIS_OPENCLAW_GATEWAY_TOKEN.
JARVIS_OPENCLAW_GATEWAY_URL=
JARVIS_REQUIRE_CONFIRMATION_FOR_SEND=true
JARVIS_OPENCLAW_AUTOPILOT_ENABLED=true
JARVIS_OPENCLAW_AUTO_SYNC_ALLOWLIST=false
JARVIS_OPENCLAW_FORWARDER_ENDPOINT=http://127.0.0.1:8000/api/openclaw/inbound
JARVIS_OPENCLAW_FORWARDER_TIMEOUT_MS=2000

JARVIS_OPENCLAW_PRODUCTIVITY_CALL_METHOD=jarvis.productivity.execute

# Proveedor para automatizaciones externas no-WhatsApp (legacy)
JARVIS_EXTERNAL_AUTOMATION_PROVIDER=openclaw

# =============================================================================
# Google Calendar
# =============================================================================
JARVIS_GOOGLE_CALENDAR_CLIENT_ID=dummy
JARVIS_GOOGLE_CALENDAR_CLIENT_SECRET=dummy
JARVIS_GOOGLE_CALENDAR_REFRESH_TOKEN=dummy
JARVIS_GOOGLE_CALENDAR_ID=primary

# =============================================================================
# LinkedIn
# =============================================================================
JARVIS_LINKEDIN_ACCESS_TOKEN=dummy
JARVIS_LINKEDIN_AUTHOR_URN=dummy
JARVIS_LINKEDIN_API_VERSION=202605
# =============================================================================
# Música (solo YouTube)
#   Con JARVIS_YOUTUBE_API_KEY se usa la YouTube Data API y se reproduce dentro
#   de JARVIS. Sin key, fallback limpio: devuelve una URL de búsqueda de YouTube
#   (no hay reproducción automática). Obtén la key en Google Cloud Console
#   (YouTube Data API v3).
# =============================================================================
JARVIS_MUSIC_ENABLED=true
JARVIS_MUSIC_PROVIDER=youtube
JARVIS_YOUTUBE_API_KEY=dummy
JARVIS_MUSIC_DEFAULT_VOLUME=50
